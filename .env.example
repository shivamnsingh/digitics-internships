# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=application-files
# --- Admin (required) ---
ADMIN_PASSWORD=change-me-to-a-long-passphrase
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
# --- Microsoft Graph / Excel (leave blank = mock mode, rows go to data/*.mock.csv) ---
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_DRIVE_ID=            # OR set MICROSOFT_SITE_ID to use a SharePoint site's default drive
MICROSOFT_SITE_ID=
MICROSOFT_WORKBOOK_ID=         # driveItem id of the .xlsx
MICROSOFT_TABLE_NAME=Digitics_Internship_Applications
# --- Confirmation email via Graph sendMail (leave blank = email skipped, logged only) ---
MAIL_SENDER=                   # mailbox UPN, e.g. internships@digitics.com (needs Mail.Send app permission)
# --- Site ---
OFFICE_LOCATION=Office location to be announced   # can also be edited in Admin
DATA_DIR=./data
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# --- Free Google Sheets sync (recommended alternative to Microsoft Excel) ---
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
